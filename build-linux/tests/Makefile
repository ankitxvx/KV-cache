	cd /mnt/c/Users/ankit/OneDrive/Desktop/KVcacheproject/build-linux && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
